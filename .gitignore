.impeccable/

# Per-developer signing (see Config/Signing.xcconfig)
Config/Signing.local.xcconfig

# Playback Lab
scripts/playback-lab/*.local.json
scripts/playback-lab/results/
__pycache__/

# Vendored VLCKit binaries, iOS + tvOS — fetched by scripts/fetch-mobilevlckit.sh
Packages/ParallaxPlayback/Vendor

